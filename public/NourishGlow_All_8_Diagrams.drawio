  <!-- PAGE 5: SEQUENCE DIAGRAM -->
  <diagram id="page5" name="5. Sequence Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title5" value="5. SEQUENCE DIAGRAM — Descending Timeline (Order &amp; Payment Flow)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="650" height="30" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="life_user" value=":User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="100" height="740" as="geometry" />
        </mxCell>
        <mxCell id="life_client" value=":Client App" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="120" height="740" as="geometry" />
        </mxCell>
        <mxCell id="life_server" value=":API Server" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="120" height="740" as="geometry" />
        </mxCell>
        <mxCell id="life_gateway" value=":Payment Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="140" height="740" as="geometry" />
        </mxCell>
        <mxCell id="life_db" value=":Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="100" height="740" as="geometry" />
        </mxCell>

        <!-- Messages 1 to 10 -->
        <mxCell id="seq1" value="1. Click 'Pay Now'" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="160" as="sourcePoint" /><mxPoint x="400" y="160" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq2" value="2. POST /api/razorpay/create-order (amount, currency)" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="210" as="sourcePoint" /><mxPoint x="660" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq3" value="3. createOrder(amount, currency)" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="260" as="sourcePoint" /><mxPoint x="930" y="260" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq4" value="4. return {order_id, key}" style="endArrow=open;dashed=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="930" y="310" as="sourcePoint" /><mxPoint x="660" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq5" value="5. response {order_id, key}" style="endArrow=open;dashed=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="360" as="sourcePoint" /><mxPoint x="400" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq6" value="6. Open payment modal (UPI / Card / NetBanking)" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="410" as="sourcePoint" /><mxPoint x="130" y="410" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq7" value="7. Authenticate &amp; Authorize Payment" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="460" as="sourcePoint" /><mxPoint x="400" y="460" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq8" value="8. POST /api/razorpay/verify-payment (signature)" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="510" as="sourcePoint" /><mxPoint x="660" y="510" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq9" value="9. verifySignature(HMAC SHA-256)" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="560" as="sourcePoint" /><mxPoint x="930" y="560" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq10" value="10. signature valid = true" style="endArrow=open;dashed=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="930" y="600" as="sourcePoint" /><mxPoint x="660" y="600" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq11" value="11. saveOrder(orderId, status='Paid')" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="650" as="sourcePoint" /><mxPoint x="1150" y="650" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq12" value="12. write confirmation OK" style="endArrow=open;dashed=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="690" as="sourcePoint" /><mxPoint x="660" y="690" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq13" value="13. order confirmed {orderId, receipt}" style="endArrow=open;dashed=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="730" as="sourcePoint" /><mxPoint x="400" y="730" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="seq14" value="14. Display Order Confirmation &amp; Download Invoice" style="endArrow=open;dashed=1;html=1;strokeColor=#334155;fontColor=#0f172a;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="770" as="sourcePoint" /><mxPoint x="130" y="770" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 6: ACTIVITY DIAGRAM -->
  <diagram id="page6" name="6. Activity Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title6" value="6. ACTIVITY DIAGRAM — Checkout Flow with Decision Loops" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="550" height="30" as="geometry" />
        </mxCell>

        <!-- Initial Node -->
        <mxCell id="act_start" value="" style="ellipse;fillColor=#334155;strokeColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="485" y="70" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Action 1 -->
        <mxCell id="act1" value="Select Products &amp; Add to Cart" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Action 2 -->
        <mxCell id="act2" value="Enter Indian Shipping Address" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="400" y="230" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decision 1: Payment Method -->
        <mxCell id="dec1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="480" y="320" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Branch A: COD -->
        <mxCell id="act_cod" value="Save Order with Status 'Pending COD'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="180" y="440" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Branch B: Online -->
        <mxCell id="act_online" value="Initiate Online Payment (Razorpay SDK)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="400" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="act_verify" value="Verify HMAC SHA-256 Signature" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="490" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Decision 2: Signature Valid? -->
        <mxCell id="dec2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="710" y="580" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Failure Action (Retry Loop) -->
        <mxCell id="act_fail" value="Display Payment Failure &amp; Prompt Retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="575" width="210" height="50" as="geometry" />
        </mxCell>

        <!-- Merge / Invoice -->
        <mxCell id="act_invoice" value="Generate Invoice &amp; Save to Database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="400" y="690" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="act_notify" value="Send Confirmation Email &amp; UI Receipt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="400" y="780" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Final Node -->
