        <!-- CLASS: User -->
        <mxCell id="c_user" value="User&#xa;--&#xa;- userId: String&#xa;- name: String&#xa;- email: String&#xa;- password: String&#xa;- skinType: String&#xa;- primaryConcerns: String[]&#xa;--&#xa;+ register()&#xa;+ login()&#xa;+ updateProfile()&#xa;+ viewRoutine()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
