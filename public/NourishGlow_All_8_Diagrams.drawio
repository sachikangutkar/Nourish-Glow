          <mxGeometry x="610" y="350" width="200" height="190" as="geometry" />
        </mxCell>

        <!-- CLASS: Payment -->
        <mxCell id="c_payment" value="Payment&#xa;--&#xa;- paymentId: String&#xa;- method: String&#xa;- amountINR: Double&#xa;- status: String&#xa;--&#xa;+ processPayment()&#xa;+ verifyPayment()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
