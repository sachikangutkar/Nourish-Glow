        <!-- CLASS: SkincareProduct -->
        <mxCell id="c_product" value="SkincareProduct&#xa;--&#xa;- productId: String&#xa;- name: String&#xa;- brand: String&#xa;- category: String&#xa;- priceINR: Double&#xa;- ingredients: String[]&#xa;- stock: Integer&#xa;--&#xa;+ checkAvailability()&#xa;+ calculateDiscount()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
