        </mxCell>

        <!-- CLASS: SkinAnalysis -->
        <mxCell id="c_analysis" value="SkinAnalysis&#xa;--&#xa;- analysisId: String&#xa;- skinType: String&#xa;- acneScore: Double&#xa;- hydrationScore: Double&#xa;- sensitivityScore: Double&#xa;- oilinessScore: Double&#xa;- analysisDate: Date&#xa;--&#xa;+ analyzeSkin()&#xa;+ generateReport()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="220" height="210" as="geometry" />
        </mxCell>

        <!-- CLASS: SkincareRoutine -->
        <mxCell id="c_routine" value="SkincareRoutine&#xa;--&#xa;- routineId: String&#xa;- morningSteps: String[]&#xa;- eveningSteps: String[]&#xa;- reminders: String&#xa;--&#xa;+ generateRoutine()&#xa;+ updateRoutine()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="220" height="170" as="geometry" />
        </mxCell>

        <!-- CLASS: Cart -->
        <mxCell id="c_cart" value="Cart&#xa;--&#xa;- cartId: String&#xa;- totalAmount: Double&#xa;--&#xa;+ addProduct()&#xa;+ removeProduct()&#xa;+ calculateTotal()" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ffffff;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1">
