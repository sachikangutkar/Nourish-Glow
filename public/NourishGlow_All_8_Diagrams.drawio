        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="2. CLASS DIAGRAM (UML Table Format)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;" vertex="1" parent="1">
